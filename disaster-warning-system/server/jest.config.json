{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "modules/uc2-reports/**/*.ts",
    "!modules/uc2-reports/**/*.dto.ts",
    "!modules/uc2-reports/**/*.module.ts"
  ],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node"
}
