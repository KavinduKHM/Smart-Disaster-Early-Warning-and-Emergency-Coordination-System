# =================================================================
# DISASTER EARLY-WARNING SYSTEM - ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port & Mongo DB
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/disaster_db
JWT_SECRET=super-secret-disaster-warning-key-2026

# =================================================================
# REAL EMAIL INTEGRATION (NODEMAILER / SMTP / GMAIL / SENDGRID)
# =================================================================
# Provide your SMTP credentials below to send real emails to citizens.
# If left blank, email notifications will run in safe simulation mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-disaster-centre-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Disaster Management Centre SL" <no-reply@disaster.gov.lk>

# =================================================================
# REAL WHATSAPP & SMS INTEGRATION (TWILIO API)
# =================================================================
# Provide your Twilio Account SID and Auth Token to send real WhatsApp & SMS.
# If left blank, WhatsApp & SMS notifications will run in safe simulation mode.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+1234567890
